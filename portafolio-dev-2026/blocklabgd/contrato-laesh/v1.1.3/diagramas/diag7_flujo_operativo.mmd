flowchart TD
    %% Estilos de Nodos
    classDef actor fill:#EDF2F7,stroke:#4A5568,stroke-width:2px,font-weight:bold,color:#2D3748;
    classDef portal fill:#EBF8FF,stroke:#2B6CB0,stroke-width:2px,color:#2B6CB0,font-weight:bold;
    classDef estado fill:#FEFCBF,stroke:#B7791F,stroke-width:2px,color:#975A16,font-weight:bold;
    classDef sistema fill:#F7FAFC,stroke:#A0AEC0,stroke-width:2px,stroke-dasharray: 5 5;

    %% Actores
    M[Médico Tratante]:::actor
    P[Paciente]:::actor
    R[Recepcionista]:::actor

    %% Portales y Sistemas
    PM[Portal Médico<br>laesh.mx/medicos]:::portal
    PR[Portal Recepción<br>laesh.mx/labadmin]:::portal
    S[Sistema Bloc Digital]:::sistema

    %% Estados
    E1(Estado: Remitido):::estado
    E2(Estado: En Atención):::estado
    E3(Estado: Resultados Listos):::estado
    E4(Estado: Cerrada):::estado

    %% Secuencia del Flujo Operativo (R4 - R16)
    M -->|R4. Captura datos de Orden| PM
    PM -->|Transmite datos| S
    S -->|Inicializa Orden| E1
    S -->|R5. Asocia Folio y Código Barras| PM
    PM -->|R6. Entrega Hoja Impresa| P
    S -.->|R7. Notificación instantánea<br>con Sonido Silbato| PR
    
    P -->|R6. Acude con Hoja a Recepción| R
    R -->|R9. Busca en Autocompletado| PR
    PR -->|R10. Cambia a En Atención| E2
    
    R -->|R11. Sube PDF de Resultados| PR
    PR -->|Carga manual de PDF| S
    S -->|R12. Cambio automático de Estado| E3
    E3 -.->|R13. Globito silencioso con Enlace PDF| PM
    PM -->|R14. Descarga PDF| M
    
    P -->|R15. Recibe Resultados Impresos| R
    R -->|R16. Cierre Manual de la Orden| PR
    PR -->|Actualiza a Cerrada| E4
