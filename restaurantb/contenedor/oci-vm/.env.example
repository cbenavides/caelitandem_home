# ============================================================
#  .env.example — Variables de entorno OCI VM (plantilla)
#  Copiar a .env y reemplazar valores antes de deploy:
#    cp .env.example .env && nano .env
#
#  NUNCA commitear .env con passwords reales.
# ============================================================

# ── MariaDB ─────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=CAMBIAR_ROOT_PASS_OCI
MARIADB_DATABASE=laesh_db
MARIADB_USER=laesh_app
MARIADB_PASSWORD=CAMBIAR_LAESH_APP_PASS_OCI
