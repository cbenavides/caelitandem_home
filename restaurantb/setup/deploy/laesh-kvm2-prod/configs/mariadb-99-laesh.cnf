# ==============================================================================
# LAESH Bloc Digital — MariaDB 11.8 config
# Target: /etc/mysql/mariadb.conf.d/99-laesh.cnf
# Adaptado de: contenedor/conf/mariadb-restaurantb.cnf
# Tuning: Hostinger KVM2 · 8 GB RAM · 4 vCPU · NVMe 100 GB
# Cambio clave: bind-address 0.0.0.0 → 127.0.0.1 (nativo, sin red Docker)
# Logs → /opt/laesh/logs/
# ==============================================================================

[mysqld]

# ── Seguridad ──────────────────────────────────────────────────────────────────
bind-address                = 127.0.0.1   # solo loopback — nunca exponer a red
skip-name-resolve                         # evitar lentitud por DNS reverse lookup

# ── Charset ───────────────────────────────────────────────────────────────────
character-set-server        = utf8mb4
collation-server            = utf8mb4_unicode_ci

# ── Motor InnoDB — Tuning KVM2 ────────────────────────────────────────────────
default-storage-engine      = InnoDB

# Buffer pool: 2 G = 25% de 8 GB (regla servidor compartido: 20-30%)
# Presupuesto: OS 300M + Nginx 20M + Swoole 150M + PHP-FPM 1.5G + MariaDB 2.2G ≈ 4.2G
# Headroom libre: ~3.8 GB — seguro para picos de carga simultánea.
innodb_buffer_pool_size     = 2G
# 1 instancia por GB de pool ≥ 1 GB (reduce contención de mutex)
innodb_buffer_pool_instances = 2

innodb_log_file_size        = 256M
innodb_flush_log_at_trx_commit = 1        # ACID completo (seguro para producción)
innodb_flush_method         = O_DIRECT    # evita doble buffer con NVMe/SSD
innodb_file_per_table       = 1

# NVMe: capacidad IO real muy superior al default de HDD (200 IOPS)
# Hostinger KVM2 NVMe ≈ 50-100K IOPS; valores conservadores pero eficaces.
innodb_io_capacity          = 2000        # default: 200 (pensado para HDD)
innodb_io_capacity_max      = 4000        # ráfagas de escritura (checkpoint, flush)

# Threads IO: explícito a 4 para aprovechar los 4 vCPU
innodb_read_io_threads      = 4
innodb_write_io_threads     = 4

# ── Tablas temporales en memoria ──────────────────────────────────────────────
# Default 16M causa volcados a disco en GROUP BY / ORDER BY complejos.
# 64M previene el volcado para casi todas las queries de LAESH.
tmp_table_size              = 64M
max_heap_table_size         = 64M

# ── Buffers por sesión ────────────────────────────────────────────────────────
# Solo se asignan cuando la query los necesita (no son globales permanentes).
join_buffer_size            = 2M          # joins sin índice (default 256K)
sort_buffer_size            = 2M          # ORDER BY sin índice (default 256K)
read_rnd_buffer_size        = 1M          # lecturas aleatorias (filesort)

# ── MyISAM (tablas de sistema internas) ───────────────────────────────────────
key_buffer_size             = 16M         # tablas .MYI del sistema (no app)

# ── Conexiones ────────────────────────────────────────────────────────────────
max_connections             = 150         # PHP-FPM 30 workers × PDO persistent = bien
max_allowed_packet          = 64M
thread_stack                = 256K
thread_cache_size           = 16          # reutilizar threads (reduce fork overhead)
open_files_limit            = 65535       # alineado al ulimit del sistema

# ── Timeouts y control de consultas largas ────────────────────────────────────
wait_timeout                = 600
interactive_timeout         = 600
max_statement_time          = 10          # mata queries > 10s (error 1969)
long_query_time             = 2           # slow log para queries > 2s (más útil que 10s)

# ── Modo SQL ──────────────────────────────────────────────────────────────────
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION

# ── Logging ───────────────────────────────────────────────────────────────────
log_error                   = /opt/laesh/logs/mariadb-error.log
slow_query_log              = 1
slow_query_log_file         = /opt/laesh/logs/mariadb-slow.log
log_queries_not_using_indexes = 0         # demasiado ruidoso para producción

# ── Timezone ──────────────────────────────────────────────────────────────────
# (Timezone se setea en la conexión desde PHP via SET time_zone='-06:00')

# ── Binary log (para recuperación punto en tiempo) ────────────────────────────
# Deshabilitado en KVM2 básico; habilitar si se requiere PITR
# log_bin = /opt/laesh/logs/mysql-bin
# expire_logs_days = 7

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
