#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# SECRETS.env.example — Plantilla de credenciales · LAESH KVM2 Producción
#
# INSTRUCCIONES:
#   1. Copiar a SECRETS.env:
#        cp SECRETS.env.example SECRETS.env
#   2. Editar SECRETS.env con las contraseñas reales
#   3. Proteger: chmod 600 SECRETS.env
#   4. NUNCA commitear SECRETS.env (está en .gitignore)
#
# SECRETS.env es leído por full_install.sh para:
#   a) Escribir /opt/laesh/configs/.env en KVM2 (fuente de verdad en servidor)
#   b) Pasar credenciales a kvm2_setup.sh durante el setup
#
# En KVM2 (una vez escrito por full_install.sh):
#   /opt/laesh/configs/.env  → 600 root:root
#   /opt/laesh/configs/.mariadb-root.cnf → 600 root:root (ya existe, no se toca)
# ══════════════════════════════════════════════════════════════════════════════

# Contraseña del usuario laesh_app en MariaDB.
# Debe coincidir con la que ya tiene laesh_app en la BD si no se hace --drop.
# Con --drop se recrea la BD y laesh_app se crea con esta contraseña.
LAESH_APP_PASS='cambiarme-antes-de-deploy-2026!'

# Contraseña root de MariaDB.
# Requerida por 06_deploy_app.sh (--drop recrea la BD; --skip-bd la omite).
# También usada por kvm2_setup.sh al correr setup completo con --nuke.
# Se pasa inline al script: LAESH_ROOT_PASS='...' LAESH_APP_PASS='...' sudo -E bash 06_deploy_app.sh
# full_install.sh NO la escribe en .env del servidor (no se almacena en disco).
LAESH_ROOT_PASS='cambiarme-antes-de-deploy-2026!'

# Contraseña SMTP para swaks (alertas por email).
# Vacío = alertas SMTP deshabilitadas (paso de hardening imprimirá advertencia).
LAESH_SMTP_PASS=''
