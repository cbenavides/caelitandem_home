# ==============================================================================
# LAESH — notificaciones-retencion.cron
# PEN-LAESH-04 (2026-10-01) — purga física de notificaciones leídas antiguas
# Target: /etc/cron.d/laesh-notificaciones-retencion (instalado por 07_security_harden.sh)
#
# Qué hace notificaciones_retencion.php:
#   DELETE físico de filas de `notificaciones` con leido=1 y creado_en más
#   antiguo que configuraciones.notif_retencion_dias (7-365, default 30). Las
#   notificaciones NO leídas nunca se purgan sin importar su antigüedad.
#
# Frecuencia: 3:00 AM diario (entre ws-logs-retention 2:00 AM y
#             auto-cierre-resultados 4:00 AM).
# Usuario: www-data (mismo que PHP-FPM)
#
# ── Variables de entorno para CLI ────────────────────────────────────────────
# Mismo patrón que ws-logs-retention.cron — LAESH_DB_PASS y LAESH_JWT_SECRET se
# sustituyen por 07_security_harden.sh (placeholders __LAESH_APP_PASS__/
# __LAESH_JWT_SECRET__). Sin LAESH_JWT_SECRET, config.php falla fail-loud en el
# bootstrap (Gap 1) — ver incidente 2026-09-19.
# ==============================================================================

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LAESH_CACHE_DIR=/opt/laesh/cache
LAESH_DB_HOST=127.0.0.1
LAESH_DB_PORT=3306
LAESH_DB_USER=laesh_app
LAESH_DB_PASS=__LAESH_APP_PASS__
LAESH_DB_NAME=laesh_db
LAESH_JWT_SECRET=__LAESH_JWT_SECRET__
APP_ENV=production

# ── Purga de notificaciones leídas antiguas (diaria, 3:00 AM) ────────────────
0 3 * * * www-data /usr/bin/php8.3 /opt/laesh/www/laesh-swbldi/crons/notificaciones_retencion.php >> /opt/laesh/logs/notificaciones-retencion.log 2>&1
