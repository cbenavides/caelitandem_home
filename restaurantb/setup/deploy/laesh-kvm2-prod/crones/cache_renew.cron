# ==============================================================================
# LAESH — cache_renew.cron
# Entrada crontab para renovación diaria de Cache L2 (OPcache File Store)
# Target: /etc/cron.d/laesh-cache-renew   (instalado por 07_security_harden.sh)
#
# Qué hace cache_renew.php:
#   1. Cache::clear()          → elimina archivos .php en /opt/laesh/cache/
#   2. Warm-up de 4 datasets   → re-consulta MariaDB y regenera los 4 archivos cache
#      - LAESH_CFG   (configuraciones institucionales)
#      - LAESH_CMS   (web_contenidos editorial)
#      - LAESH_TREE  (árbol catálogos clínicos)
#      - LAESH_PROMOS (promociones vigentes)
#   Benchmark: warm-up completo ~13 ms → cache caliente al inicio de la jornada
#
# Frecuencia: 5:00 AM diario (antes de que abra el laboratorio)
#             @reboot → también ejecutar al arrancar el servidor (tmpfs limpio)
#
# Usuario: www-data (mismo que PHP-FPM → puede escribir /opt/laesh/cache/)
#
# ── Por qué LAESH_CACHE_DIR=/opt/laesh/cache (no /tmp) ──────────────────────
# Ubuntu 24.04: el servicio php8.3-fpm.service tiene PrivateTmp=true.
# Esto hace que PHP-FPM vea su PROPIO /tmp aislado del /tmp del sistema.
# Si cache_renew.php escribiera a /tmp/laesh_cache/ (vía sys_get_temp_dir()),
# PHP-FPM leería su /tmp privado → cache miss permanente → warm-up inútil.
# Solución: usar /opt/laesh/cache/ (mismo path en cron y en FPM pool config).
#
# ── Variables de entorno para CLI (no las inyecta PHP-FPM) ──────────────────
# La configuración de BD se lee desde getenv() en config.php.
# En modo FPM las vars las provee el pool (php-fpm-laesh.conf).
# En CLI (cron) hay que inyectarlas aquí.
# LAESH_DB_PASS se substituye por 07_security_harden.sh al copiar este cron
# (patrón __LAESH_APP_PASS__, igual que en php-fpm-laesh.conf).
# ==============================================================================

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LAESH_CACHE_DIR=/opt/laesh/cache
LAESH_DB_HOST=127.0.0.1
LAESH_DB_PORT=3306
LAESH_DB_USER=laesh_app
LAESH_DB_PASS=__LAESH_APP_PASS__
LAESH_DB_NAME=laesh_db
APP_ENV=production

# ── 1/3 PHP: Renovar archivos cache en /opt/laesh/cache/ (5:00 AM) ───────────
# Purga los 4 archivos .php y los regenera desde MariaDB.
# Tras este paso los archivos existen en disco, pero NO en el OPcache de FPM todavía.
0 5 * * * www-data /usr/bin/php8.3 /opt/laesh/www/laesh-swbldi/crons/cache_renew.php >> /opt/laesh/logs/cache-renew.log 2>&1

# ── 2/3 FPM warm-up HTTP: pre-calentar OPcache de workers FPM (5:01 AM) ──────
# Por qué CLI no es suficiente: opcache_compile_file() desde CLI compila en el
# OPcache del proceso CLI (su propio shared memory segment). Los workers FPM tienen
# su PROPIO segmento — CLI no puede escribir en él.
# Mecanismo: curl hace GET /laesh/ → Nginx → worker FPM → website/index.php →
#   Cache::get() → @include '/opt/laesh/cache/laesh_cache_prod_LAESH_CFG.php' (×4)
#   → OPcache compila los 4 archivos y los guarda en shared memory de FPM.
# Resultado: a partir de la 2a request del día, Cache::get() = bytecode puro <0.1ms.
# sleep 5: margen para que el paso 1/3 termine de escribir antes de que curl lea.
# -k: acepta self-signed cert (Modo A); --max-time 15: timeout de seguridad.
1 5 * * * www-data sleep 5 && curl -sf -k https://127.0.0.1/laesh/ -H "Host: localhost" -o /dev/null --max-time 15 >> /opt/laesh/logs/cache-renew.log 2>&1

# ── 3/3 Warm-up al arrancar el servidor (@reboot) ─────────────────────────────
# Tras un reboot /opt/laesh/cache/ está vacío (y el OPcache de FPM también es nuevo).
# El cron diario de las 5 AM ya pasó si el servidor arrancó a las 10 AM.
# sleep 90: espera a que MariaDB + PHP-FPM + Nginx estén completamente listos.
# El && encadena PHP warm-up → sleep 15 → curl FPM warm-up en una sola línea.
@reboot www-data sleep 90 && /usr/bin/php8.3 /opt/laesh/www/laesh-swbldi/crons/cache_renew.php >> /opt/laesh/logs/cache-renew-boot.log 2>&1 && sleep 15 && curl -sf -k https://127.0.0.1/laesh/ -H "Host: localhost" -o /dev/null --max-time 15 >> /opt/laesh/logs/cache-renew-boot.log 2>&1

# ── OPcache status periódico (observabilidad — activar si se necesita) ────────
# */15 * * * * www-data /usr/bin/php8.3 -r "print_r(opcache_get_status(false));" >> /opt/laesh/logs/opcache-status.log 2>&1
