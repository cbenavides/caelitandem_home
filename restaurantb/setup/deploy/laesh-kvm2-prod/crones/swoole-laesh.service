# ==============================================================================
# LAESH Bloc Digital — systemd unit para Swoole WebSocket Server
# Target: /etc/systemd/system/swoole-laesh.service
# Instalar: systemctl daemon-reload && systemctl enable swoole-laesh
# ==============================================================================

[Unit]
Description=LAESH Swoole WebSocket + HTTP IPC Server (port 9502)
Documentation=https://swoole.com
After=network.target mariadb.service php8.3-fpm.service
Requires=mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data

# Swoole entry point
ExecStart=/usr/bin/php8.3 /opt/laesh/www/laesh-swbldi/commons/swoole_server.php

# Health check post-arranque: verifica que Swoole escucha en 9502 antes de
# que systemd marque el servicio como active. sleep 3 = margen para que el
# proceso PHP inicialice el socket antes del primer curl.
# FIX 2026-09-08 (G-SWOOLE-03): sin este check, systemd reporta active aunque
# el binding haya fallado (puerto ocupado, permiso denegado, etc.)
ExecStartPost=/bin/bash -c 'sleep 3 && curl -sf http://127.0.0.1:9502/status > /dev/null'

# Graceful restart: SIGTERM al proceso, 10s para cerrar conexiones WS activas
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=10

# ExecReload: SIGHUP → Swoole master recarga workers sin cerrar el listener.
# Usado por logrotate postrotate ('systemctl reload swoole-laesh') para que
# los workers reabran el file descriptor del log rotado.
# FIX 2026-09-08 (G-SWOOLE-04): antes se usaba SIGUSR1, que en Swoole v6
# dispara un worker-reload completo y desconecta clientes WS activos.
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy: siempre reiniciar si el proceso muere (no por stop manual)
Restart=always
RestartSec=5s

# Recursos
LimitNOFILE=65535
LimitNPROC=1024

# Logging al journal (accesible con: journalctl -u swoole-laesh -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swoole-laesh

# Variables de entorno del pool PHP-FPM (deben coincidir)
Environment=APP_ENV=production
# CRÍTICO (2026-09-18): PrivateTmp=true aísla el /tmp de este servicio del de
# PHP-FPM/cron. Sin esto, Cache::init() caería a sys_get_temp_dir() (el /tmp
# privado de Swoole) en vez de /opt/laesh/cache — la verificación de revocación
# JTI del handshake WS (Cache::get('JTI_...')) SIEMPRE fallaría (fail-closed),
# rechazando toda conexión WS. Debe coincidir con env[LAESH_CACHE_DIR] del pool
# PHP-FPM y con LAESH_CACHE_DIR de cache_renew.cron.
Environment=LAESH_CACHE_DIR=/opt/laesh/cache
# LAESH_DB_* no son necesarios aquí: Swoole no hace queries a BD;
# el bridge /publish recibe eventos y los reenvía via WS.
# EnvironmentFile: mismo /opt/laesh/configs/.env que escribe full_install.sh (600 root:root).
# Provee LAESH_JWT_SECRET — usado por la verificación de firma en el handshake WS
# (auditoría 2026-09-18, §2.4c Especificacion_Tecnica). Sin dash: si el archivo falta,
# el servicio NO debe arrancar silenciosamente sin el secreto.
EnvironmentFile=/opt/laesh/configs/.env

# Seguridad: sandbox del proceso
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/laesh/logs /opt/laesh/www /opt/laesh/cache
PrivateTmp=true

[Install]
WantedBy=multi-user.target
